# ============================================================
# Framework Command Center — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ============================================================

# ─── Supabase (Required) ──────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API

# Your Supabase project URL (safe to expose — it's a public URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anon / public key (safe to expose — it's restricted by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# ─── Supabase Service Role (Optional) ────────────────────────────────────────
# Only needed for server-side admin operations (backup/restore API).
# KEEP THIS SECRET — never expose to the browser or commit to git.
# Get from: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# ─── Notes ────────────────────────────────────────────────────────────────────
# The NEXT_PUBLIC_ prefix means these variables are embedded in the browser bundle.
# Variables without this prefix are server-only (never sent to the browser).
#
# For local development:
#   1. Create a Supabase project at supabase.com
#   2. Run supabase/schema.sql in the SQL editor
#   3. Copy your URL and anon key here
#   4. Run: npm run dev
#
# For Vercel deployment:
#   Add these same variables in Vercel → Settings → Environment Variables
#   See SETUP.md for the complete deployment guide
